# Meu Custo — Variáveis de Ambiente
# Copie para .env.local e preencha os valores

# ⚠️ ATENÇÃO: Este arquivo contém APENAS placeholders.
# NUNCA comite valores reais. Adicione .env.local ao .gitignore.
# Os valores reais são armazenados via Vercel Environment Variables.

# Supabase (self-hosted na infra DuoBro — stack supabase-wacrm)
NEXT_PUBLIC_SUPABASE_URL=https://seu-supabase-url.duobro.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder.anon-key

# 🔒 SUPABASE_SERVICE_ROLE_KEY — NUNCA expor publicamente ou em .env.example.
# Esta chave tem acesso admin total ao banco. Use APENAS no .env.local
# ou nas Vercel Environment Variables. O valor real NÃO está documentado aqui.
# Obter via: ssh manager1 "docker exec supabase-wacrm_db psql -U postgres -c 'SELECT key FROM vault.secrets;'"
# SUPABASE_SERVICE_ROLE_KEY=<NUNCA_COLOCAR_AQUI>

# Google OAuth (configurado no Gotrue do Supabase self-hosted)
# Client ID obtido em https://console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=NNNNNNNNNN-apps.googleusercontent.com

# URL base da aplicação (para callbacks OAuth)
NEXT_PUBLIC_SITE_URL=https://meucusto.vercel.app

# Feature flags
NEXT_PUBLIC_ENABLE_SYNC=true

# Sentry DSN (observabilidade — opcional)
NEXT_PUBLIC_SENTRY_DSN=
